# Server Configuration
PORT=5000
HOST=0.0.0.0

# External Inventory System (EIS) Database Configuration (Sequelize ORM)
EIS_DB_HOST=127.0.0.1
EIS_DB_PORT=3306
EIS_DB_DATABASE=external_inventory_db
EIS_DB_USERNAME=root
EIS_DB_PASSWORD=
EIS_DB_DIALECT=mysql

# Security: AMS -> Microservice Lookup (JWT Authentication)
JWT_SECRET=ams-microservice-lookup-secret-key-jwt-auth
JWT_A_SECRET=ams-microservice-lookup-secret-key-jwt-auth
JWT_ISSUER=ams
JWT_AUDIENCE=microservice-lookup

# (Legacy / Fallback EIS HTTP URL)
EIS_BASE_URL=http://localhost:9000/api/v1
