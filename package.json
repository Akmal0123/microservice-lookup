{
  "name": "microservice-lookup",
  "version": "2.0.0",
  "description": "Microservice Lookup between AMS (Approval Management System) and EIS (External Inventory System) with Sequelize ORM",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --test",
    "test:orm": "tsx test-sequelize.ts",
    "test:pdf": "tsx test-dynamic-pdf.ts",
    "generate:templates": "tsx scripts/generate-templates.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "axios": "^1.7.9",
    "dotenv": "^16.4.7",
    "fastify": "^4.28.1",
    "handlebars": "^4.7.10",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.24.4",
    "pdfkit": "^0.20.2",
    "sequelize": "^6.37.8",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.10",
    "@types/pdfkit": "^0.17.6",
    "@types/xml2js": "^0.4.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
